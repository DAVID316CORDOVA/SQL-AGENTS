{
  "base_de_datos": "demo_db",
  "descripcion": "Sistema de gestión universitaria que almacena estudiantes, cursos, inscripciones y auditoría",
  "tablas": {
    "students": {
      "descripcion": "Tabla que almacena información personal, académica y de riesgo de los estudiantes",
      "columnas": {
        "student_id": {
          "tipo": "INT",
          "descripcion": "Identificador unico del estudiante (clave primaria)"
        },
        "name": {
          "tipo": "VARCHAR(100)",
          "descripcion": "Nombre completo del estudiante",
          "ejemplo": "Ana Garcia Lopez"
        },
        "email": {
          "tipo": "VARCHAR(100)",
          "descripcion": "Correo electronico unico del estudiante",
          "ejemplo": "ana.garcia@universidad.edu"
        },
        "age": {
          "tipo": "INT",
          "descripcion": "Edad del estudiante en anos",
          "ejemplo": 21
        },
        "enrollment_date": {
          "tipo": "DATE",
          "descripcion": "Fecha de inscripcion del estudiante",
          "ejemplo": "2023-09-01"
        },
        "status": {
          "tipo": "ENUM",
          "descripcion": "Estado academico actual del estudiante. Solo acepta valores del ENUM definido.",
          "ejemplo": "active"
        },
        "gpa": {
          "tipo": "DECIMAL(3,2)",
          "descripcion": "Promedio general acumulado del estudiante. Rango 0.00 a 4.00.",
          "ejemplo": 3.45
        },
        "city": {
          "tipo": "VARCHAR(50)",
          "descripcion": "Ciudad de residencia del estudiante. Almacena el nombre de la ciudad donde vive el estudiante.",
          "ejemplo": "East Yolandabury, Matthewton, North Sergioland, New Kristinfort, South Troyborough"
        },
        "risk_score": {
          "tipo": "INT",
          "descripcion": "Puntaje de riesgo de abandono. Valor entero de 0 a 100.",
          "ejemplo": 35
        },
        "loyalty_level": {
          "tipo": "ENUM",
          "descripcion": "Nivel de compromiso del estudiante. Columna tipo ENUM.",
          "ejemplo": "high"
        }
      }
    },
    "courses": {
      "descripcion": "Tabla que almacena información de los cursos",
      "columnas": {
        "course_id": {
          "tipo": "INT",
          "descripcion": "Identificador unico del curso (clave primaria)"
        },
        "course_name": {
          "tipo": "VARCHAR(100)",
          "descripcion": "Nombre de la asignatura o materia academica universitaria. Puede ser cualquier materia que ofrezca la universidad.",
          "ejemplo": "Calculo Diferencial"
        },
        "course_code": {
          "tipo": "VARCHAR(20)",
          "descripcion": "Codigo alfanumerico unico del curso",
          "ejemplo": "MAT-201"
        },
        "credits": {
          "tipo": "INT",
          "descripcion": "Numero de creditos academicos del curso",
          "ejemplo": 4
        },
        "department": {
          "tipo": "VARCHAR(50)",
          "descripcion": "Departamento academico al que pertenece el curso. Puede ser cualquier departamento de la universidad.",
          "ejemplo": "Ciencias Exactas"
        },
        "level": {
          "tipo": "ENUM",
          "descripcion": "Nivel academico del curso.",
          "ejemplo": "intermediate"
        },
        "max_students": {
          "tipo": "INT",
          "descripcion": "Capacidad maxima de estudiantes por curso",
          "ejemplo": 40
        },
        "professor_name": {
          "tipo": "VARCHAR(100)",
          "descripcion": "Nombre del profesor asignado al curso. Referencia a la tabla professors.",
          "ejemplo": "Dr. Martinez"
        },
        "description": {
          "tipo": "TEXT",
          "descripcion": "Descripción del curso"
        },
        "is_active": {
          "tipo": "BOOLEAN",
          "valores": [
            true,
            false
          ],
          "descripcion": "Indica si el curso está activo actualmente."
        }
      }
    },
    "enrollments": {
      "descripcion": "Tabla que almacena las inscripciones de estudiantes en cursos",
      "columnas": {
        "enrollment_id": {
          "tipo": "INT",
          "descripcion": "Identificador unico de la matricula (clave primaria)"
        },
        "student_id": {
          "tipo": "INT",
          "descripcion": "Referencia al estudiante (FK a students.student_id)"
        },
        "course_id": {
          "tipo": "INT",
          "descripcion": "Referencia al curso (FK a courses.course_id)"
        },
        "enrollment_date": {
          "tipo": "DATE",
          "descripcion": "Fecha de matricula en el curso",
          "ejemplo": "2024-01-15"
        },
        "grade": {
          "tipo": "DECIMAL(4,2)",
          "descripcion": "Calificacion obtenida en el curso. Valor numerico decimal.",
          "ejemplo": 8.5
        },
        "attendance_percentage": {
          "tipo": "DECIMAL(5,2)",
          "descripcion": "Porcentaje de asistencia al curso",
          "ejemplo": 92.5
        },
        "status": {
          "tipo": "ENUM",
          "descripcion": "Estado de la matricula.",
          "ejemplo": "enrolled"
        },
        "semester": {
          "tipo": "VARCHAR(20)",
          "descripcion": "Semestre academico de la matricula",
          "ejemplo": "2024-1"
        },
        "year": {
          "tipo": "INT",
          "descripcion": "Año académico de la matrícula."
        }
      }
    },
    "professors": {
      "descripcion": "Tabla que almacena información de los profesores de la universidad",
      "columnas": {
        "professor_id": {
          "tipo": "INT",
          "descripcion": "Identificador unico del profesor (clave primaria)"
        },
        "name": {
          "tipo": "VARCHAR(100)",
          "descripcion": "Nombre completo del profesor",
          "ejemplo": "Dr. Roberto Sanchez"
        },
        "email": {
          "tipo": "VARCHAR(100)",
          "descripcion": "Correo electronico del profesor",
          "ejemplo": "r.sanchez@universidad.edu"
        },
        "department": {
          "tipo": "VARCHAR(50)",
          "descripcion": "Departamento academico al que pertenece el profesor.",
          "ejemplo": "Ingenieria"
        },
        "hire_date": {
          "tipo": "DATE",
          "descripcion": "Fecha de contratacion del profesor",
          "ejemplo": "2018-03-15"
        },
        "salary": {
          "tipo": "DECIMAL(10,2)",
          "descripcion": "Salario del profesor. Valor numerico.",
          "ejemplo": 4500.0
        }
      }
    }
  }
}